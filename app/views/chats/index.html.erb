<% content_for :title, "Workspaces" %>
<div class="mx-auto max-w-3xl">
  <div class="pb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Workspaces</h1>
    <p class="mt-1 text-sm text-muted-foreground">Each workspace is a conversation with the analyst that builds its own screens.</p>
  </div>

  <% if @chats.empty? %>
    <%= poetry_empty do |empty| %>
      <% empty.with_media { poetry_icon(name: :"layout-dashboard", class: "size-6") } %>
      <% empty.with_title { "No workspaces yet" } %>
      <% empty.with_description { "Start one and ask the analyst a question about the bank." } %>
    <% end %>
  <% else %>
    <%= poetry_table do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Workspace" } %>
          <%= poetry_table_head(class: "text-right") { "Surfaces" } %>
          <%= poetry_table_head(class: "text-right") { "Updated" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <% @chats.each do |chat| %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell { link_to chat.display_title, chat, class: "font-medium hover:underline" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { chat.surface_ids.size.to_s } %>
            <%= poetry_table_cell(class: "text-right text-muted-foreground") { "#{time_ago_in_words(chat.updated_at)} ago" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
