<% content_for :title, @chat.display_title %>
<% content_for :workspace_title, @chat.display_title %>
<%= turbo_stream_from @chat %>

<%# The workspace: surfaces grow on the canvas; the chat moves from center stage to the bottom-right as they arrive. %>
<div class="group/workspace relative min-h-[70vh]"
     data-controller="workspace"
     data-workspace-state-value="<%= @tiles.any? ? "docked" : "hero" %>"
     data-state="<%= @tiles.any? ? "docked" : "hero" %>">
  <section id="surfaces" data-workspace-target="surfaces" aria-label="Workspace surfaces"
           class="grid grid-cols-1 gap-6 transition-[padding] duration-300 xl:group-data-[state=docked]/workspace:pr-[29rem]">
    <%= render partial: "surfaces/tile", collection: @tiles, as: :tile, locals: { chat: @chat } %>
  </section>

  <%= render "chats/dock", chat: @chat, messages: @messages %>
</div>
